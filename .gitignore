# Flutter and Dart generated state.
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/build/
coverage/
**/coverage/

# Android and desktop tool caches.
**/.gradle/
**/local.properties
**/GeneratedPluginRegistrant.*
**/ephemeral/
.idea/
.vscode/
*.iml

# Local agent state and command output.
.agents/
.codex_*
.sha1
_*
tmp-*
*.log

# Scratch captures kept outside the curated regression/golden directories.
/*.png
/*.xml
/*.txt

# Runtime/device evidence is intentionally retained on disk, but is too large
# and machine-specific for the source baseline. Curated test goldens remain
# tracked under test/goldens and example/test/goldens.
artifacts/
test/failures/
example/test/failures/

# Binary Release aliases/checkpoints are generated by the Release cycle. Keep
# the human-readable release manifest under source control.
releases/*.apk
releases/*.apk.sha256
releases/*.zip
releases/*-SHA256SUMS.txt

# Operating-system and scripting caches.
Thumbs.db
.DS_Store
**/__pycache__/
**/*.pyc
